# Desarrollo local
DATABASE_URL=postgresql+psycopg://salesia:salesia@localhost:5432/salesia
SECRET_KEY=replace-with-a-long-random-secret-before-deployment
ACCESS_TOKEN_MINUTES=60
CORS_ORIGINS=http://localhost:5173
ENVIRONMENT=development

# Ventana compartida de intentos de autenticación (PostgreSQL)
AUTH_WINDOW_SECONDS=900
AUTH_ACCOUNT_ATTEMPTS=10
AUTH_IP_ATTEMPTS=100

# Tolerancia a conexiones remotas y renovación de conexiones
DATABASE_CONNECT_TIMEOUT=15
DATABASE_POOL_TIMEOUT=15
DATABASE_POOL_RECYCLE=300
